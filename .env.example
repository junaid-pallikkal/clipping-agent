# ====================================================================
# CLIPGENIUS AI — Environment Configuration Template
# ====================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTES:
# - Variables prefixed with VITE_ are exposed to the client-side bundle.
# - NEVER put secret API keys, private tokens, or service role keys in VITE_ variables.
# - Server-side keys (without VITE_) belong strictly in Supabase Edge Functions / Vault.
# ====================================================================

# --------------------------------------------------------------------
# 1. APPLICATION & CLIENT CONFIGURATION
# --------------------------------------------------------------------
VITE_APP_NAME="CLIPGENIUS AI"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development"

# --------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Cloud or Local Studio)
# --------------------------------------------------------------------
# Get these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL="https://keggecbqykrpvdlfufzj.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_AShsSYywN-83-C1x8X13KA_Xpb8_s35"

# Server-side only (for Edge Functions & Migrations - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_PROJECT_ID="your-project-ref"

# --------------------------------------------------------------------
# 3. AI SERVICES (Speech-to-Text & Semantic Analysis)
# --------------------------------------------------------------------
# Google Gemini 2.5 Flash / Pro (Hook detection & Virality analysis)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# Deepgram Nova-2 (Word-level timestamps & Speaker Diarization)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY="your-deepgram-api-key"

# OpenAI Whisper (Optional alternative for speech-to-text)
OPENAI_API_KEY="sk-proj-..."

# --------------------------------------------------------------------
# 4. SOCIAL MEDIA OAUTH 2.0 APIS (Server-Side Vault)
# --------------------------------------------------------------------
# Server-side 32-byte encryption key for token storage (AES-256-GCM)
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="your-32-byte-base64-aes-encryption-key"

# YouTube Data API v3 (Google Cloud Console)
# Scopes: https://www.googleapis.com/auth/youtube.upload
YOUTUBE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="GOCSPX-..."
YOUTUBE_REDIRECT_URI="http://localhost:5173/auth/callback/youtube"

# Instagram Graph API & Facebook Pages (Meta for Developers)
# Scopes: instagram_basic, instagram_content_publish, pages_show_list
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:5173/auth/callback/instagram"

# TikTok Content Posting API (TikTok for Developers)
# Scopes: video.upload, video.publish, user.info.basic
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:5173/auth/callback/tiktok"

# --------------------------------------------------------------------
# 5. MONETIZATION & BILLING (Stripe)
# --------------------------------------------------------------------
# Public key for client-side Stripe Elements / Checkout redirect
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Secret key for server-side checkout session creation
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret for invoice/subscription sync
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs for Subscription Tiers
VITE_STRIPE_PRICE_CREATOR="price_creator_monthly_..."
VITE_STRIPE_PRICE_PRO="price_pro_monthly_..."
VITE_STRIPE_PRICE_AGENCY="price_agency_monthly_..."
